        upperBound="2" eType="#//Prerequisit"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Attribute" eSuperTypes="#//Prerequisit"/>
  <eClassifiers xsi:type="ecore:EClass" name="ContextDependentProperty" eSuperTypes="#//Prerequisit"/>
  <eClassifiers xsi:type="ecore:EClass" name="NOT" eSuperTypes="#//Connector"/>
  <eClassifiers xsi:type="ecore:EClass" name="AND" eSuperTypes="#//Connector"/>
  <eClassifiers xsi:type="ecore:EClass" name="OR" eSuperTypes="#//Connector"/>
  <eClassifiers xsi:type="ecore:EClass" name="LegalNormRules" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity">
