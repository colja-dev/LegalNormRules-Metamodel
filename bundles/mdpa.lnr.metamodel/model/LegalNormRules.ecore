    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="LegalNormRules" nsURI="http://www.example.org/LegalNormRules"
    nsPrefix="LegalNormRules">
  <eClassifiers xsi:type="ecore:EClass" name="LegalConsequence" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity">
